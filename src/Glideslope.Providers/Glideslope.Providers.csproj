<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Glideslope.Domain\Glideslope.Domain.csproj" />
    <!-- The CLI transports find the app's per-user cache and data roots through
         Glideslope.Core's DefaultUserPathProvider (which honors proof roots), with no new app wiring. -->
    <ProjectReference Include="..\Glideslope.Core\Glideslope.Core.csproj" />
    <InternalsVisibleTo Include="Glideslope.Providers.Specs" />
  </ItemGroup>
</Project>
